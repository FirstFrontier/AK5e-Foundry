<section class="ak5e-arts-dialog">
  <fieldset>
    <legend>{{localize "AK5E.Arts.Casting"}}</legend>
    <p>{{ak5eArts.value}} / {{ak5eArts.maximum}} {{localize "AK5E.Arts.AP"}}</p>
    {{#if ak5eArts.chooseMode}}
    <label>{{localize "AK5E.Arts.CastingMode"}}
      <select name="ak5eMode">{{selectOptions ak5eArts.modes selected=ak5eArts.mode valueAttr="value" labelAttr="label"}}</select>
    </label>
    {{else}}
    <p>{{ak5eArts.modeLabel}}</p><input type="hidden" name="ak5eMode" value="{{ak5eArts.mode}}">
    {{/if}}
    {{#if ak5eArts.chooseLevel}}
    <label>{{localize "AK5E.Arts.CastLevel"}}
      <select name="ak5eLevel">{{selectOptions ak5eArts.options selected=ak5eArts.level valueAttr="value" labelAttr="label"}}</select>
    </label>
    {{else}}
    {{#unless ak5eArts.unavailable}}<p>{{ak5eArts.levelLabel}}</p>{{/unless}}
    <input type="hidden" name="ak5eLevel" value="{{ak5eArts.level}}">
    {{/if}}
    {{#if ak5eArts.unavailable}}<p role="alert">{{ak5eArts.reason}}</p>{{else}}
    <p role="status">{{localize "AK5E.Arts.AfterCast"}}: {{ak5eArts.remaining}} {{localize "AK5E.Arts.AP"}}</p>
    {{/if}}
    {{#if ak5eArts.source}}<p>{{ak5eArts.source}}</p>{{/if}}
    {{#each ak5eArts.modifiers}}<p>{{source}}: {{amount}} AP</p>{{/each}}
    {{#if ak5eArts.origin}}<p>Art origin: the selected Arts Master's space.</p>{{/if}}
    {{#if ak5eArts.ritual}}<p>{{localize "AK5E.Arts.RitualHint"}}</p>{{/if}}
    {{#each ak5eArts.castOptions as |option|}}
    <fieldset data-ak5e-option="{{option.id}}">
      <legend>{{option.label}}</legend>
      {{#each option.fieldsModel as |field|}}
      {{#if (eq field.type "hidden")}}
      <input type="hidden" name="{{field.inputName}}" value="{{field.value}}">
      {{else}}
      <label>{{field.label}}
        {{#if (eq field.type "checkbox")}}
        <input type="checkbox" name="{{field.inputName}}" {{checked field.value}}>
        {{else if (eq field.type "select")}}
        <select name="{{field.inputName}}">{{selectOptions field.options selected=field.value valueAttr="value" labelAttr="label"}}</select>
        {{else if (eq field.type "number")}}
        <input type="number" name="{{field.inputName}}" value="{{field.value}}" min="{{field.min}}" max="{{field.max}}" step="{{field.step}}">
        {{else}}
        <input type="text" name="{{field.inputName}}" value="{{field.value}}">
        {{/if}}
      </label>
      {{#if field.hint}}<p>{{field.hint}}</p>{{/if}}
      {{/if}}
      {{/each}}
    </fieldset>
    {{/each}}
    {{#each ak5eArts.castOptionWarnings}}<p role="alert">{{this.text}}</p>{{/each}}
    {{#each ak5eArts.castContextWarnings}}<p role="alert">{{this.text}}</p>{{/each}}
    <p>{{localize "AK5E.Arts.ConsumptionHint"}}</p>
  </fieldset>
</section>
